    "typecheck": "tsc --noEmit",
    "functions:lint": "npm --prefix functions run lint",
    "functions:build": "npm --prefix functions run build",
    "functions": "npm run functions:lint && npm run functions:build",
    "doctor": "npx expo-doctor",
    "verify:quick": "node scripts/verify.mjs --quick",
    "verify:fast": "node scripts/verify.mjs --fast",
    "verify": "node scripts/verify.mjs --quick",
    "verify:visual": "node scripts/verify.mjs --visual",
