    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint src",
    "test": "vitest run",
    "test:activity": "node --test tests/*.test.cjs",
    "test:rn": "node scripts/run-rn-tests.mjs",
    "test:rules": "jest --config jest.rules.config.js --runInBand",
