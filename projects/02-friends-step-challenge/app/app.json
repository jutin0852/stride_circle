{
  "expo": {
    "name": "Stride Circle",
    "slug": "stride-circle",
    "scheme": "stride-circle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-system-ui",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to use in your walk share.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2563EB",
          "image": "./assets/stride-circle-splash.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#111F29",
            "image": "./assets/stride-circle-splash.png"
          }
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Stride Circle uses your motion activity to show your steps to you and your circle."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Stride Circle uses your location to center the Activity map and record your route, distance, and pace when you start a walk.",
          "locationAlwaysAndWhenInUsePermission": "Stride Circle uses your location during an active walk so recording continues when your phone is locked. Recording stops when you pause or finish.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "@appeeky/expo-healthkit",
        {
          "healthSharePermission": "Stride Circle reads your step count to show your progress and circle standings.",
          "healthUpdatePermission": false,
          "isBackgroundDeliveryEnabled": true,
          "isHealthConnectBackgroundReadEnabled": true,
          "healthConnectPermissions": ["READ_STEPS"]
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.stridecircle.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.iam_jutin.stridecircle"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
