# Firebase console → Project settings → Your apps → Web app
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional local-only Auth + Firestore emulator mode (development builds only).
# Use a demo-* project ID, never your live Firebase project ID.
# Web/iOS simulator: 127.0.0.1; Android emulator: 10.0.2.2.
# Physical-device access needs an explicitly LAN-bound emulator; do not expose it to untrusted networks.
# EXPO_PUBLIC_FIREBASE_USE_EMULATORS=true
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Google OAuth public client IDs from the SAME Firebase/Google Cloud project.
# Native iOS requires both IDs and a new build for its reversed-client-ID scheme.
# Native Android uses WEB_CLIENT_ID plus an Android OAuth registration matching
# android.package and the actual APK signing SHA-1. No Android ID is passed to JS.
# Web uses Firebase's popup flow and its authorized-domain configuration.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# iOS defaults to the foreground Pedometer provider so free-signed builds do
# not request the unavailable HealthKit entitlement. Set this to "healthkit"
# only in a paid, HealthKit-enabled iOS build.
# EXPO_PUBLIC_HEALTH_DATA_PROVIDER=healthkit

# Public-scoped Mapbox client token (pk.), never a secret sk. token.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# HTTPS media gateway; ImageKit private keys belong ONLY in server secret storage.
EXPO_PUBLIC_MEDIA_API_URL=
# Native build only: configure RNMAPBOX_MAPS_DOWNLOAD_TOKEN as an EAS/GitHub
# secret with Downloads:Read. Never prefix it with EXPO_PUBLIC_ or commit it.
