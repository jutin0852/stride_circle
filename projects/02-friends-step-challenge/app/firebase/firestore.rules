rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function maxCircleMembers() {
      return 20;
    }

    // Well above a very long walking day; anything higher is not plausible.
    function maxDailySteps() {
      return 100000;
    }

    function dateKeyStart(dateKey) {
      return timestamp.date(int(dateKey[0:4]), int(dateKey[5:7]), int(dateKey[8:10]));
    }

    // Daily step totals are client-reported, so bound what a client can claim:
    // a whole, plausible number for a real day that is not in the future and
    // not older than the offline sync window.
    function isPlausibleDailySteps(dateKey) {
      return request.resource.data.steps is int
        && request.resource.data.steps >= 0
        && request.resource.data.steps <= maxDailySteps()
        && request.resource.data.dateKey == dateKey
        && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && dateKeyStart(dateKey) <= request.time + duration.value(1, 'd')
        && dateKeyStart(dateKey) >= request.time - duration.value(15, 'd')
        && request.resource.data.updatedAt == request.time;
    }

    function hasOnlyStepFields(fields) {
      return resource == null
        ? request.resource.data.keys().hasOnly(fields)
        : request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function signedIn() {
      return request.auth != null;
    }

    function isCircleOwner(circleId) {
      return get(/databases/$(database)/documents/circles/$(circleId)).data.ownerId == request.auth.uid;
    }

    function isDeletingCircle(circleId) {
      return !existsAfter(/databases/$(database)/documents/circles/$(circleId));
    }

    function isCircleMember(circleId) {
      return signedIn()
        && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
    }

    function isCircleModerator(circleId) {
      return isCircleMember(circleId)
        && (
          get(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid)).data.role == 'owner'
          || get(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid)).data.role == 'moderator'
        );
    }

    function isPublicOpenCircle(circleId) {
      return exists(/databases/$(database)/documents/circles/$(circleId))
        && get(/databases/$(database)/documents/circles/$(circleId)).data.visibility == 'public'
        && get(/databases/$(database)/documents/circles/$(circleId)).data.joinPolicy == 'open';
    }

    function isPublicOpenCircleAfter(circleId) {
      return getAfter(/databases/$(database)/documents/circles/$(circleId)).data.visibility == 'public'
        && getAfter(/databases/$(database)/documents/circles/$(circleId)).data.joinPolicy == 'open';
    }

    // A new member record must raise the stored count by exactly one in the same
    // write, so the member cap cannot be bypassed by writing the record alone.
    function isJoinWithCountIncrement(circleId) {
      return exists(/databases/$(database)/documents/circles/$(circleId))
        && getAfter(/databases/$(database)/documents/circles/$(circleId)).data.memberCount
          == get(/databases/$(database)/documents/circles/$(circleId)).data.memberCount + 1
        && getAfter(/databases/$(database)/documents/circles/$(circleId)).data.memberCount <= maxCircleMembers();
    }

    // Member names are copies of the user's profile name; they may stay as they
    // are or follow the profile, but never diverge from it.
    function isAllowedMemberDisplayName(memberId) {
      return request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && (
          (resource != null && request.resource.data.displayName == resource.data.displayName)
          || request.resource.data.displayName == getAfter(/databases/$(database)/documents/users/$(memberId)).data.displayName
        );
    }

    function isValidCircleReportTarget(circleId, targetType, targetId) {
      return (
          targetType == 'circle'
          && targetId == circleId
          && exists(/databases/$(database)/documents/circles/$(circleId))
          && (isCircleMember(circleId) || isPublicOpenCircle(circleId))
        )
        || (
          (targetType == 'member' || targetType == 'profile')
          && targetId != request.auth.uid
          && isCircleMember(circleId)
          && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(targetId))
        )
        || (
          targetType == 'cheer'
          && isCircleMember(circleId)
          && exists(/databases/$(database)/documents/circles/$(circleId)/cheers/$(targetId))
        )
        || (
          targetType == 'message'
          && isCircleMember(circleId)
          && exists(/databases/$(database)/documents/circles/$(circleId)/messages/$(targetId))
        );
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /users/{userId}/dailySteps/{dateKey} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && hasOnlyStepFields(['dateKey', 'source', 'steps', 'timeZone', 'updatedAt'])
        && isPlausibleDailySteps(dateKey)
        && request.resource.data.source in ['expo-pedometer', 'health-connect', 'healthkit', 'ios-pedometer']
        && request.resource.data.timeZone is string
        && request.resource.data.timeZone.size() <= 100;
      allow delete: if false;
    }

    match /users/{userId}/walkingJournal/{dateKey} {
      allow get, list: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['createdAt', 'dateKey', 'note', 'schemaVersion', 'updatedAt'])
        && request.resource.data.dateKey == dateKey
        && request.resource.data.note is string
        && request.resource.data.note.size() > 0
        && request.resource.data.note.size() <= 500
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['createdAt', 'dateKey', 'note', 'schemaVersion', 'updatedAt'])
        && request.resource.data.dateKey == dateKey
        && request.resource.data.note is string
        && request.resource.data.note.size() > 0
        && request.resource.data.note.size() <= 500
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/activities/{activityId} {
      allow create, read: if signedIn() && request.auth.uid == userId;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/activities/{activityId}/rawRoute/{chunkId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/walkDetails/{activityId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/plannedWalks/{routeId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/blocks/{blockedUserId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.blockedUserId == blockedUserId
        && blockedUserId != request.auth.uid
        && request.resource.data.keys().hasOnly(['blockedUserId', 'createdAt', 'displayName', 'schemaVersion'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.schemaVersion == 1;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/circleMemberships/{circleId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && (
          getAfter(/databases/$(database)/documents/circles/$(circleId)).data.inviteCode == circleId
          || isPublicOpenCircleAfter(circleId)
        )
        && (
          (
            request.auth.uid == getAfter(/databases/$(database)/documents/circles/$(circleId)).data.ownerId
            && request.resource.data.role == 'owner'
          )
          || (
            request.auth.uid != getAfter(/databases/$(database)/documents/circles/$(circleId)).data.ownerId
            && request.resource.data.role == 'member'
          )
        );
      allow update: if signedIn()
        && (
          (
            (
              request.auth.uid == userId
              || (
                isCircleOwner(circleId)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['circleName', 'updatedAt'])
                && request.resource.data.circleName == getAfter(/databases/$(database)/documents/circles/$(circleId)).data.name
              )
            )
            && request.resource.data.role == resource.data.role
          )
          || (
            isCircleOwner(circleId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && resource.data.role in ['member', 'moderator']
            && request.resource.data.role in ['member', 'moderator']
            && getAfter(/databases/$(database)/documents/circles/$(circleId)/members/$(userId)).data.role == request.resource.data.role
          )
        );
      // A non-owner may leave, while the circle owner may remove another member.
      // The owner can remove their own membership only while deleting the circle.
      allow delete: if signedIn()
        && (
          (request.auth.uid == userId && !isCircleOwner(circleId))
          || (isCircleOwner(circleId) && request.auth.uid != userId)
          || (request.auth.uid == userId && isCircleOwner(circleId) && isDeletingCircle(circleId))
        );
    }

    // ---- Usernames, public profiles, invites and friends ----

    // Kept in sync with src/domain/usernames.ts.
    function isValidUsername(handle) {
      return handle is string
        && handle.matches('^[a-z][a-z0-9_.]{2,19}$')
        && !handle.matches('.*[.][.].*')
        && !handle.matches('.*[.]$')
        && !(handle in ['admin', 'administrator', 'help', 'moderator', 'official', 'root', 'stride', 'stridecircle', 'support', 'system', 'waka']);
    }

    // Blocks are private to their owner, so only rules can check them both ways.
    function isBlockedEitherWay(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/blocks/$(b))
        || exists(/databases/$(database)/documents/users/$(b)/blocks/$(a));
    }

    function isUsernameCooldownOver() {
      return resource.data.get('usernameChangedAt', null) == null
        || resource.data.usernameChangedAt <= request.time - duration.value(30, 'd');
    }

    // The searchable projection of a profile. Its name must match the private
    // profile, and its handle must be claimed by this user in the same write.
    function isValidPublicProfile(userId) {
      return request.resource.data.keys().hasOnly(['avatarSeed', 'avatarStyle', 'discoverable', 'displayName', 'displayNameLower', 'schemaVersion', 'updatedAt', 'userId', 'username', 'usernameChangedAt'])
        && request.resource.data.keys().hasAll(['avatarSeed', 'avatarStyle', 'discoverable', 'displayName', 'displayNameLower', 'schemaVersion', 'updatedAt', 'userId', 'username'])
        && request.resource.data.userId == userId
        && request.resource.data.schemaVersion == 1
        && request.resource.data.discoverable is bool
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.displayNameLower is string
        && request.resource.data.displayNameLower.size() <= 100
        && request.resource.data.avatarSeed is string
        && request.resource.data.avatarSeed.size() <= 100
        && request.resource.data.avatarStyle is string
        && request.resource.data.avatarStyle.size() <= 40
        && request.resource.data.updatedAt == request.time
        && isValidUsername(request.resource.data.username)
        && request.resource.data.displayName == getAfter(/databases/$(database)/documents/users/$(userId)).data.displayName
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == userId;
    }

    // One document per handle makes the handle unique: creating an existing
    // document is an update, which is denied.
    match /usernames/{handle} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && isValidUsername(handle)
        && request.resource.data.keys().hasOnly(['createdAt', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.username == handle;
      allow update: if false;
      // Only the owner can release a handle, and only once their profile has moved on.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && (
          !existsAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
          || getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.username != handle
        );
    }

    match /publicProfiles/{userId} {
      allow get: if signedIn();
      // Search only sees people who are discoverable, in small pages.
      allow list: if signedIn()
        && resource.data.discoverable == true
        && request.query.limit <= 20;
      allow create: if signedIn()
        && request.auth.uid == userId
        && isValidPublicProfile(userId)
        && request.resource.data.get('usernameChangedAt', null) == null;
      allow update: if signedIn()
        && request.auth.uid == userId
        && isValidPublicProfile(userId)
        && (
          (
            request.resource.data.username == resource.data.username
            && request.resource.data.get('usernameChangedAt', null) == resource.data.get('usernameChangedAt', null)
          )
          || (
            request.resource.data.username != resource.data.username
            && isUsernameCooldownOver()
            && request.resource.data.usernameChangedAt == request.time
            && !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username))
          )
        );
      allow delete: if false;
    }

    // Owners and moderators invite by username; the person accepts through the
    // acceptCircleInvite function, which re-checks every rule with admin access.
    match /circleInvites/{inviteId} {
      allow get, list: if signedIn()
        && (
          resource.data.inviteeId == request.auth.uid
          || resource.data.inviterId == request.auth.uid
          || isCircleModerator(resource.data.circleId)
        );
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['circleId', 'circleName', 'createdAt', 'expiresAt', 'inviteeId', 'inviterDisplayName', 'inviterId', 'schemaVersion'])
        && inviteId == request.resource.data.circleId + '_' + request.resource.data.inviteeId
        && request.resource.data.inviterId == request.auth.uid
        && request.resource.data.inviteeId is string
        && request.resource.data.inviteeId != request.auth.uid
        && request.resource.data.inviterDisplayName is string
        && request.resource.data.inviterDisplayName.size() > 0
        && request.resource.data.inviterDisplayName.size() <= 100
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt >= request.time + duration.value(13, 'd')
        && request.resource.data.expiresAt <= request.time + duration.value(15, 'd')
        && isCircleModerator(request.resource.data.circleId)
        && request.resource.data.circleName == get(/databases/$(database)/documents/circles/$(request.resource.data.circleId)).data.name
        && get(/databases/$(database)/documents/circles/$(request.resource.data.circleId)).data.memberCount < maxCircleMembers()
        && !exists(/databases/$(database)/documents/circles/$(request.resource.data.circleId)/members/$(request.resource.data.inviteeId))
        && !exists(/databases/$(database)/documents/circles/$(request.resource.data.circleId)/removedMembers/$(request.resource.data.inviteeId))
        && !isBlockedEitherWay(request.auth.uid, request.resource.data.inviteeId)
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.inviteeId));
      allow update: if false;
      allow delete: if signedIn()
        && (
          resource.data.inviteeId == request.auth.uid
          || resource.data.inviterId == request.auth.uid
          || isCircleModerator(resource.data.circleId)
        );
    }

    match /friendRequests/{requestId} {
      allow get, list: if signedIn()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['createdAt', 'fromDisplayName', 'fromId', 'schemaVersion', 'toId'])
        && requestId == request.resource.data.fromId + '_' + request.resource.data.toId
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.toId is string
        && request.resource.data.toId != request.auth.uid
        && request.resource.data.fromDisplayName is string
        && request.resource.data.fromDisplayName.size() > 0
        && request.resource.data.fromDisplayName.size() <= 100
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.toId))
        && !isBlockedEitherWay(request.auth.uid, request.resource.data.toId)
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(request.resource.data.toId));
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
    }

    // The recipient of a friend request creates both sides of the friendship in
    // one batch that also deletes the request. Either person can end one by
    // deleting both sides in a batch.
    match /users/{userId}/friends/{friendId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && (request.auth.uid == userId || request.auth.uid == friendId)
        && userId != friendId
        && request.resource.data.keys().hasOnly(['createdAt', 'friendId', 'schemaVersion'])
        && request.resource.data.friendId == friendId
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt == request.time
        // The request runs from the other person to the signed-in user.
        && exists(/databases/$(database)/documents/friendRequests/$((request.auth.uid == userId ? friendId : userId) + '_' + request.auth.uid))
        && !existsAfter(/databases/$(database)/documents/friendRequests/$((request.auth.uid == userId ? friendId : userId) + '_' + request.auth.uid))
        && !isBlockedEitherWay(userId, friendId);
      allow update: if false;
      allow delete: if signedIn() && (request.auth.uid == userId || request.auth.uid == friendId);
    }

    match /globalLeaderboards/{boardId} {
      allow get: if signedIn();
      allow list, create, update, delete: if false;

      match /entries/{userId} {
        allow get, list: if signedIn();
        allow create, update, delete: if false;
      }
    }

    match /circles/{circleId} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.visibility == 'public';
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.inviteCode == circleId
        && request.resource.data.memberCount == 1
        && request.resource.data.visibility == 'private'
        && request.resource.data.joinPolicy == 'invite_only'
        || (
          signedIn()
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.inviteCode == null
          && request.resource.data.memberCount == 1
          && request.resource.data.visibility == 'public'
          && request.resource.data.joinPolicy == 'open'
        );
      allow update: if signedIn()
        && (
          (
            isCircleOwner(circleId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description', 'discoverableArea', 'name', 'updatedAt', 'weeklyStepGoal'])
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.inviteCode == resource.data.inviteCode
            && request.resource.data.activityType == resource.data.activityType
            && (!request.resource.data.keys().hasAny(['weeklyStepGoal']) || (request.resource.data.weeklyStepGoal is int && request.resource.data.weeklyStepGoal >= 10000 && request.resource.data.weeklyStepGoal <= 5000000))
          )
          || (
            isPublicOpenCircle(circleId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt'])
            && request.resource.data.memberCount == resource.data.memberCount + 1
            && request.resource.data.memberCount <= maxCircleMembers()
            && !exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid))
          )
          || (
            signedIn()
            && resource.data.inviteCode == circleId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt'])
            && request.resource.data.memberCount == resource.data.memberCount + 1
            && request.resource.data.memberCount <= maxCircleMembers()
            && !exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid))
          )
          // A decrement must name the member removed in the same write, so the
          // count can only fall when someone actually leaves or is removed.
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'removedMemberId', 'updatedAt'])
            && request.resource.data.memberCount == resource.data.memberCount - 1
            && request.resource.data.removedMemberId is string
            && (isCircleOwner(circleId) || request.resource.data.removedMemberId == request.auth.uid)
            && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.resource.data.removedMemberId))
            && !existsAfter(/databases/$(database)/documents/circles/$(circleId)/members/$(request.resource.data.removedMemberId))
          )
        );
      allow delete: if signedIn() && isCircleOwner(circleId);

      match /members/{memberId} {
        allow get, list: if signedIn()
          && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
        allow create: if signedIn()
          && request.auth.uid == memberId
          && request.resource.data.userId == request.auth.uid
          && isAllowedMemberDisplayName(memberId)
          // Someone the owner removed cannot rejoin with the invite code.
          && !exists(/databases/$(database)/documents/circles/$(circleId)/removedMembers/$(memberId))
          && (
            getAfter(/databases/$(database)/documents/circles/$(circleId)).data.inviteCode == circleId
            || isPublicOpenCircleAfter(circleId)
          )
          && (
            (
              request.auth.uid == getAfter(/databases/$(database)/documents/circles/$(circleId)).data.ownerId
              && request.resource.data.role == 'owner'
              && (
                !exists(/databases/$(database)/documents/circles/$(circleId))
                || isJoinWithCountIncrement(circleId)
              )
            )
            || (
              request.auth.uid != getAfter(/databases/$(database)/documents/circles/$(circleId)).data.ownerId
              && request.resource.data.role == 'member'
              && isJoinWithCountIncrement(circleId)
            )
          );
        allow update: if signedIn()
          && (
            (
              request.auth.uid == memberId
              && request.resource.data.userId == request.auth.uid
              && isAllowedMemberDisplayName(memberId)
              && (
                getAfter(/databases/$(database)/documents/circles/$(circleId)).data.inviteCode == circleId
                || (
                  isPublicOpenCircleAfter(circleId)
                  && getAfter(/databases/$(database)/documents/circles/$(circleId)).data.memberCount <= maxCircleMembers()
                )
              )
              && (
                (
                  request.auth.uid == getAfter(/databases/$(database)/documents/circles/$(circleId)).data.ownerId
                  && request.resource.data.role == 'owner'
                )
                || (
                  request.auth.uid != getAfter(/databases/$(database)/documents/circles/$(circleId)).data.ownerId
                  && request.resource.data.role == resource.data.role
                  && request.resource.data.role in ['member', 'moderator']
                )
              )
            )
            || (
              isCircleOwner(circleId)
              && request.resource.data.userId == resource.data.userId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
              && resource.data.role in ['member', 'moderator']
              && request.resource.data.role in ['member', 'moderator']
              && getAfter(/databases/$(database)/documents/users/$(memberId)/circleMemberships/$(circleId)).data.role == request.resource.data.role
            )
          );
        // Matches the membership rule above, so the two records are removed atomically.
        allow delete: if signedIn()
          && (
            (request.auth.uid == memberId && !isCircleOwner(circleId))
            || (isCircleOwner(circleId) && request.auth.uid != memberId)
            || (request.auth.uid == memberId && isCircleOwner(circleId) && isDeletingCircle(circleId))
          )
          // Keep the stored count accurate: a removal lowers it in the same write.
          && (
            isDeletingCircle(circleId)
            || getAfter(/databases/$(database)/documents/circles/$(circleId)).data.memberCount
              == get(/databases/$(database)/documents/circles/$(circleId)).data.memberCount - 1
          );
      }

      // People the owner removed; their presence blocks rejoining by invite code.
      match /removedMembers/{memberId} {
        allow get: if signedIn() && (request.auth.uid == memberId || isCircleModerator(circleId));
        allow list: if isCircleModerator(circleId);
        allow create: if signedIn()
          && isCircleOwner(circleId)
          && memberId != request.auth.uid
          && request.resource.data.keys().hasOnly(['removedAt', 'removedBy', 'userId'])
          && request.resource.data.userId == memberId
          && request.resource.data.removedBy == request.auth.uid
          && request.resource.data.removedAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && (isCircleOwner(circleId) || isDeletingCircle(circleId));
      }

      match /dailySteps/{dateKey}/entries/{userId} {
        allow get, list: if signedIn()
          && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid
          && hasOnlyStepFields(['dateKey', 'steps', 'updatedAt', 'userId'])
          && isPlausibleDailySteps(dateKey)
          && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
        allow delete: if false;
      }

      match /dailyActivities/{dateKey}/entries/{userId} {
        allow get, list: if signedIn()
          && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid
          && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow get, list: if signedIn()
          && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid))
          && request.resource.data.keys().hasOnly([
            'authorAvatarSeed',
            'authorAvatarStyle',
            'authorId',
            'authorName',
            'body',
            'circleId',
            'clientMessageId',
            'createdAt',
            'schemaVersion'
          ])
          && request.resource.data.circleId == circleId
          && request.resource.data.clientMessageId == messageId
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName == get(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid)).data.displayName
          && request.resource.data.authorAvatarSeed == get(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid)).data.avatarSeed
          && request.resource.data.authorAvatarStyle == get(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid)).data.avatarStyle
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 500
          && request.resource.data.createdAt == request.time
          && request.resource.data.schemaVersion == 1;
        allow update, delete: if false;
      }

      match /walkPlans/{walkId} {
        allow get, list: if signedIn()
          && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid))
          && request.resource.data.keys().hasOnly(['createdAt', 'createdBy', 'createdByName', 'details', 'meetupLabel', 'schemaVersion', 'startsAt', 'status', 'timeZone', 'title', 'updatedAt'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdByName == get(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid)).data.displayName
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 60
          && request.resource.data.details is string
          && request.resource.data.details.size() <= 240
          && request.resource.data.meetupLabel is string
          && request.resource.data.meetupLabel.size() <= 100
          && request.resource.data.startsAt is timestamp
          && request.resource.data.startsAt > request.time
          && request.resource.data.timeZone is string
          && request.resource.data.timeZone.size() > 0
          && request.resource.data.timeZone.size() <= 100
          && request.resource.data.status == 'scheduled'
          && request.resource.data.schemaVersion == 1
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if signedIn()
          && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid))
          && (resource.data.createdBy == request.auth.uid || isCircleOwner(circleId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && resource.data.status == 'scheduled'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;

        match /rsvps/{userId} {
          allow get, list: if signedIn()
            && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
          allow create: if signedIn()
            && request.auth.uid == userId
            && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid))
            && request.resource.data.keys().hasOnly(['createdAt', 'displayName', 'going', 'updatedAt', 'userId'])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.displayName == get(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid)).data.displayName
            && request.resource.data.going == true
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time;
          allow update: if signedIn()
            && request.auth.uid == userId
            && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid))
            && request.resource.data.keys().hasOnly(['createdAt', 'displayName', 'going', 'updatedAt', 'userId'])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.displayName == get(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid)).data.displayName
            && request.resource.data.going == true
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time;
          allow delete: if signedIn()
            && request.auth.uid == userId
            && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
        }
      }

      match /days/{dateKey} {
        allow get, list: if signedIn()
          && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
        allow create, update, delete: if false;

        match /scores/{userId} {
          allow get, list: if signedIn()
            && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
          allow create, update, delete: if false;
        }
      }

      match /weeklyRecaps/{weekKey} {
        allow get, list: if signedIn()
          && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
        allow create, update, delete: if false;
      }

      match /cheers/{cheerId} {
        allow get, list: if signedIn()
          && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid))
          && request.resource.data.circleId == circleId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.recipientId is string
          && request.resource.data.recipientId != request.auth.uid
          && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.resource.data.recipientId))
          && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocks/$(request.resource.data.recipientId))
          && !exists(/databases/$(database)/documents/users/$(request.resource.data.recipientId)/blocks/$(request.auth.uid))
          && request.resource.data.cheerType in ['nice_work', 'keep_going', 'almost_there', 'lets_walk', 'congrats'];
        allow update, delete: if false;
      }

      match /reports/{reportId} {
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'circleId',
            'createdAt',
            'details',
            'reason',
            'reporterId',
            'schemaVersion',
            'status',
            'targetId',
            'targetLabel',
            'targetPreview',
            'targetType'
          ])
          && request.resource.data.keys().hasAll([
            'circleId',
            'createdAt',
            'details',
            'reason',
            'reporterId',
            'schemaVersion',
            'status',
            'targetId',
            'targetLabel',
            'targetPreview',
            'targetType'
          ])
          && request.resource.data.circleId == circleId
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.status == 'open'
          && request.resource.data.schemaVersion == 1
          && request.resource.data.createdAt == request.time
          && request.resource.data.targetId is string
          && request.resource.data.targetId.matches('^[^/]{1,128}$')
          && request.resource.data.targetType in ['circle', 'member', 'cheer', 'profile', 'message']
          && request.resource.data.reason in ['spam', 'harassment', 'unsafe', 'privacy', 'other']
          && request.resource.data.targetLabel is string
          && request.resource.data.targetLabel.size() > 0
          && request.resource.data.targetLabel.size() <= 100
          && request.resource.data.targetPreview is string
          && request.resource.data.targetPreview.size() <= 500
          && request.resource.data.details is string
          && request.resource.data.details.size() <= 500
          && reportId == request.auth.uid + '_' + request.resource.data.targetType + '_' + request.resource.data.targetId
          && (
            (
              request.resource.data.targetType == 'circle'
              && request.resource.data.targetLabel == get(/databases/$(database)/documents/circles/$(circleId)).data.name
            )
            || (
              (request.resource.data.targetType == 'member' || request.resource.data.targetType == 'profile')
              && request.resource.data.targetLabel == get(/databases/$(database)/documents/circles/$(circleId)/members/$(request.resource.data.targetId)).data.displayName
            )
            || (
              request.resource.data.targetType == 'message'
              && request.resource.data.targetLabel == get(/databases/$(database)/documents/circles/$(circleId)/messages/$(request.resource.data.targetId)).data.authorName
              && request.resource.data.targetPreview == get(/databases/$(database)/documents/circles/$(circleId)/messages/$(request.resource.data.targetId)).data.body
            )
            || (request.resource.data.targetType == 'cheer' && request.resource.data.targetLabel == 'Circle cheer')
          )
          && isValidCircleReportTarget(circleId, request.resource.data.targetType, request.resource.data.targetId);
        allow get, list: if isCircleModerator(circleId);
        allow update: if isCircleModerator(circleId)
          && resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolution', 'resolvedAt', 'resolvedBy', 'status', 'updatedAt'])
          && request.resource.data.status in ['resolved', 'dismissed']
          && request.resource.data.resolvedBy == request.auth.uid
          && request.resource.data.resolvedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.resolution is string
          && request.resource.data.resolution.size() > 0
          && request.resource.data.resolution.size() <= 100;
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
